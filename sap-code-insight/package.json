{
  "name": "sap-code-insight",
  "version": "1.0.0",
  "description": "SAP Code Insight - AI-Powered ABAP Code Analysis & BRD Document Generator",
  "repository": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26",
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^3",
    "@sap-cloud-sdk/http-client": "^3",
    "@sap/cds": "^9",
    "@sap/cds-odata-v2-adapter-proxy": "^1",
    "@sap/xsenv": "^5",
    "@sap/xssec": "^4",
    "docx": "^8",
    "express": "^4",
    "mammoth": "^1.11.0",
    "passport": "^0.7",
    "pdfkit": "^0.13"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@sap/ux-specification": "latest",
    "rimraf": "^5"
  },
  "scripts": {
    "start": "cds-serve",
    "build": "cds build --production",
    "deploy": "cf push",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "[production]": {
          "kind": "hana"
        },
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      },
      "auth": {
        "[production]": {
          "kind": "xsuaa"
        },
        "[development]": {
          "kind": "dummy"
        }
      }
    },
    "hana": {
      "deploy-format": "hdbtable"
    }
  },
  "sapux": [
    "app/fiori-ui"
  ]
}
