<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:html="http://www.w3.org/1999/xhtml"
    controllerName="com.sap.codeinsight.controller.ObjectList">

    <Page id="objectListPage"
          showNavButton="false"
          showHeader="false"
          class="sapUiResponsiveContentPadding">

        <content>
            <VBox>

                <!-- Premium Header -->
                <VBox class="codeInsightHeader">
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="codeInsightHeaderInner">
                        <HBox alignItems="Center">
                            <html:div class="diligentLogoWrap">
                                <html:img src="images/diligent-logo.png" class="diligentLogo" alt="Diligent"/>
                            </html:div>
                            <VBox class="sapUiSmallMarginBegin">
                                <Title text="SAP Code Insight" level="H3" class="codeInsightTitle"/>
                                <Label text="AI-Powered ABAP Code Analysis" class="codeInsightSubtitle"/>
                            </VBox>
                        </HBox>

                        <HBox alignItems="Center">
                            <Button
                                text="By Claude"
                                icon="sap-icon://ai"
                                type="Transparent"
                                press=".onByClaude"
                                class="codeInsightHeaderBtn"/>
                            <Button
                                text="Tenant Manager"
                                icon="sap-icon://company-view"
                                type="Transparent"
                                press=".onOpenTenantManager"
                                visible="{viewModel>/isAdmin}"
                                class="codeInsightHeaderBtn"/>
                            <Button
                                text="Upload ZIP"
                                icon="sap-icon://attachment-zip-file"
                                type="Transparent"
                                press=".onUploadZipFile"
                                class="codeInsightHeaderBtn sapUiSmallMarginBegin"/>
                            <Button
                                text="Offline Analysis"
                                icon="sap-icon://upload"
                                type="Transparent"
                                press=".onUploadCode"
                                class="codeInsightHeaderBtn sapUiSmallMarginBegin"/>
                            <Button
                                text="Refresh from SAP"
                                icon="sap-icon://synchronize"
                                type="Emphasized"
                                press=".onRefreshObjects"
                                class="sapUiSmallMarginBegin"/>
                        </HBox>
                    </HBox>

                    <!-- Search Area -->
                    <HBox justifyContent="Center" class="codeInsightSearchArea">
                        <SearchField
                            id="searchField"
                            placeholder="Search ABAP objects by name, type, or package..."
                            width="600px"
                            search=".onSearch"
                            liveChange=".onSearch"
                            class="codeInsightSearch"/>
                    </HBox>
                </VBox>

                <VBox class="sapUiSmallMargin">

                    <!-- Filter Bar -->
                    <HBox class="sapUiSmallMarginBottom" alignItems="Center" wrap="Wrap">
                        <Label text="Category:" class="sapUiSmallMarginEnd" design="Bold"/>
                        <Select id="categoryFilter"
                                selectedKey="{viewModel>/selectedCategory}"
                                change=".onCategoryFilter">
                            <items>
                                <core:Item key="ALL" text="All Objects"/>
                                <core:Item key="REPORT" text="Reports / Programs"/>
                                <core:Item key="CLASS" text="ABAP Classes"/>
                                <core:Item key="FUNCTION_MODULE" text="Function Modules"/>
                                <core:Item key="FUNCTION_GROUP" text="Function Groups"/>
                                <core:Item key="BADI" text="BADIs"/>
                                <core:Item key="ENHANCEMENT_IMPL" text="Enhancements"/>
                                <core:Item key="INCLUDE" text="Includes"/>
                            </items>
                        </Select>

                        <Label text="Namespace:" class="sapUiSmallMarginBegin sapUiSmallMarginEnd" design="Bold"/>
                        <Select id="namespaceFilter"
                                selectedKey="{viewModel>/selectedNamespace}"
                                change=".onNamespaceChange">
                            <items>
                                <core:Item key="Z" text="Z* (Customer)"/>
                                <core:Item key="Y" text="Y* (Customer)"/>
                                <core:Item key="/" text="/* (Namespace)"/>
                                <core:Item key="ALL" text="All Namespaces"/>
                            </items>
                        </Select>

                        <Input id="customNamespace"
                               placeholder="e.g. /TRM/"
                               width="120px"
                               visible="{= ${viewModel>/selectedNamespace} === '/'}"
                               value="{viewModel>/customNamespace}"
                               class="sapUiSmallMarginBegin"
                               submit=".onRefreshObjects"/>

                        <ToolbarSpacer/>

                        <ObjectStatus
                            text="{= ${viewModel>/objectCount} + ' objects found'}"
                            state="Success"
                            icon="sap-icon://database"
                            class="sapUiSmallMarginEnd"/>
                    </HBox>

                    <!-- Object Table -->
                    <Table id="objectTable"
                           items="{
                               path: '/CustomObjects',
                               sorter: { path: 'objectName' },
                               parameters: { $count: true }
                           }"
                           growing="true"
                           growingThreshold="50"
                           growingScrollToLoad="true"
                           mode="None"
                           sticky="ColumnHeaders,HeaderToolbar"
                           alternateRowColors="true"
                           class="sapUiSmallMarginTop">

                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="Custom ABAP Objects" level="H4"/>
                                <ToolbarSpacer/>
                                <Button icon="sap-icon://excel-attachment" tooltip="Export" press=".onExport"/>
                                <Button icon="sap-icon://sort" tooltip="Sort" press=".onSort"/>
                            </OverflowToolbar>
                        </headerToolbar>

                        <columns>
                            <Column width="25%"><Text text="Object Name"/></Column>
                            <Column width="20%"><Text text="Type"/></Column>
                            <Column width="15%"><Text text="Category"/></Column>
                            <Column width="15%"><Text text="Package"/></Column>
                            <Column width="12%"><Text text="Created By"/></Column>
                            <Column width="13%"><Text text="Created On"/></Column>
                        </columns>

                        <items>
                            <ColumnListItem type="Navigation" press=".onObjectPress">
                                <cells>
                                    <ObjectIdentifier title="{objectName}" text="{objectTypeText}"/>
                                    <ObjectStatus text="{objectType}"
                                        state="{= ${category} === 'CLASS' ? 'Success' :
                                                 ${category} === 'REPORT' ? 'Information' :
                                                 ${category} === 'FUNCTION_MODULE' ? 'Warning' : 'None'}"/>
                                    <Text text="{category}"/>
                                    <Text text="{package}"/>
                                    <Text text="{createdByAbap}"/>
                                    <Text text="{
                                        path: 'createdOnAbap',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: { pattern: 'dd.MM.yyyy' }
                                    }"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </VBox>
            </VBox>
        </content>

        <!-- Footer -->
        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <HBox alignItems="Center">
                    <core:Icon src="sap-icon://ai" class="sapUiTinyMarginEnd"/>
                    <Label text="AI Powered" design="Bold"/>
                </HBox>
                <ToolbarSpacer/>
            </Toolbar>
        </footer>

    </Page>
</mvc:View>
